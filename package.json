    "zod": "^3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@typescript-eslint/eslint-plugin": "^7",
    "@typescript-eslint/parser": "^7",
    "eslint": "^8",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^1"
  }
}
