{
  "name": "@orboto/mcp",
  "version": "0.51.0",
  "description": "Orboto MCP server — exposes Orboto tickets, docs, and timers as Model Context Protocol tools for Claude Desktop / Cursor / Copilot.",
  "main": "dist/index.js",
  "bin": {
    "orboto-mcp": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
