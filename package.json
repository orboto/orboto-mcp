    "agents",
    "ai"
  ],
  "homepage": "https://github.com/orboto/orboto-mcp",
  "bugs": {
    "url": "https://github.com/orboto/orboto-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orboto/orboto-mcp.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
