{
  "name": "@orboto/mcp",
  "version": "0.169.0",
  "description": "Model Context Protocol server for orboto - exposes tickets, projects, milestones, time, docs, primer-facts, alerts and absences as MCP tools for Claude Desktop / Cursor / Copilot Chat / any MCP-aware AI client.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "orboto-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@typescript-eslint/eslint-plugin": "^7",
    "@typescript-eslint/parser": "^7",
    "eslint": "^8",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^1"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "orboto",
    "mcp",
    "model-context-protocol",
    "tickets",
    "project-management",
    "claude",
    "cursor",
    "copilot",
    "agents",
    "ai"
  ],
  "homepage": "https://github.com/orboto/orboto-mcp",
  "bugs": {
    "url": "https://github.com/orboto/orboto-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orboto/orboto-mcp.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
